# Copy to `.env` and edit. All variables are optional — defaults in abp_voice/config.py.

# ── LLM (Ollama) ──────────────────────────────────────────────────────────
# ABP_LLM_MODEL=gemma3:4b           # better quality, needs GPU for speed
# ABP_LLM_MODEL=gemma3:1b           # faster on CPU
# ABP_OLLAMA_HOST=http://localhost:11434
# ABP_LLM_NUM_CTX=2048
# ABP_LLM_NUM_PREDICT=160
# ABP_LLM_KEEP_ALIVE=30m

# ── STT (faster-whisper) ─────────────────────────────────────────────────
# ABP_WHISPER_MODEL=medium           # tiny | base | small | medium | large-v3
# ABP_WHISPER_DEVICE=cpu             # or "cuda" once nvidia driver is loaded
# ABP_WHISPER_COMPUTE=int8           # float16 for cuda, int8 for cpu

# ── Retrieval ─────────────────────────────────────────────────────────────
# ABP_TOP_K=3
# ABP_CHUNK_SIZE=700

# ── Audio capture ─────────────────────────────────────────────────────────
# ABP_SILENCE_DURATION=1.2
# ABP_NOISE_MULTIPLIER=3.0

# ── HuggingFace (optional, removes anonymous rate-limit warning) ─────────
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxx
